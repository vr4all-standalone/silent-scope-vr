@@ -248,6 +251,23 @@
 	const u8 fb_packmode = gl.rendContext->fb_W_CTRL.fb_packmode;
 	const u32 tex_addr = gl.rendContext->fb_W_SOF1 & VRAM_MASK;
 
+#if !defined(GLES2)
+    if (gl.gl_major >= 3 && gl.rtt.framebuffer) {
+        const auto& ctx = *gl.rendContext;
+        const silent_scope::dc_scope::Source source{
+            settings.content.gameId.c_str(), ctx.isRTT, bool(config::RenderToTextureBuffer),
+            w, h, tex_addr, fb_packmode, ctx.fb_W_LINESTRIDE * 8,
+            ctx.fbClip.origin.x, ctx.fbClip.origin.y, ctx.fbClip.size.x, ctx.fbClip.size.y,
