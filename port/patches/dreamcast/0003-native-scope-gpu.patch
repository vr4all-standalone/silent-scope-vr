+            gl.rtt.framebuffer->getFramebuffer()
+        };
+        // A separate owned GPU image; native RTT/VRAM copy and lens remain untouched.
+        silent_scope::dc_scope::gpu_scope().capture(source,
+            reinterpret_cast<uintptr_t>(GraphicsContext::Instance()),
+            silent_scope::dc_scope::monotonic_seconds());
+    }
+#endif
+
 #if defined(_WIN32) && !defined(GLES) && !defined(GLES2)
 	// Completed native RTT, before its mandatory Silent Scope VRAM copy.
