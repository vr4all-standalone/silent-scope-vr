+#if !defined(GLES2)
+namespace {
+bool silentScopeEventsRegistered = false;
+void silentScopeInvalidateGpu(Event, void*) { silent_scope::dc_scope::gpu_scope().invalidate(); }
+constexpr Event silentScopeGpuEvents[]{Event::Start, Event::LoadState, Event::DiskChange, Event::Terminate};
+}
+#endif
+
 bool OpenGLRenderer::Init()
 {
 	glcache.EnableCache();
 
 	gl_create_resources();
+
+#if !defined(GLES2)
+    if (gl.gl_major >= 3 && silent_scope::dc_scope::gpu_scope().initialize(
+            silent_scope::dc_scope::current_gl_api(), reinterpret_cast<uintptr_t>(GraphicsContext::Instance()))) {
+        for (auto event : silentScopeGpuEvents) EventManager::listen(event, silentScopeInvalidateGpu);
+        silentScopeEventsRegistered = true;
+    }
+#endif
 
 #if 0
 	glEnable(GL_DEBUG_OUTPUT);
@@ -1442,6 +1462,11 @@
 	// the winding the cull modes were set up for.
 	if (vrEye)
 		glFrontFace(GL_CW);
+#if defined(_WIN32) && !defined(GLES) && !defined(GLES2)
+    if (!is_rtt && !vrEye)
+        silent_scope::dc_scope::environment_composite_probe().record(settings.content.gameId, *gl.rendContext,
+            silent_scope::dc_scope::monotonic_seconds());
+#endif
 	DrawStrips();
 	if (vrEye)
 		glFrontFace(GL_CCW);
@@ -1491,6 +1516,14 @@
 
 void OpenGLRenderer::Term()
 {
+#if !defined(GLES2)
+    if (silentScopeEventsRegistered) {
+        for (auto event : silentScopeGpuEvents) EventManager::unlisten(event, silentScopeInvalidateGpu);
+        silentScopeEventsRegistered = false;
+    }
+    if (!silent_scope::dc_scope::gpu_scope().release(reinterpret_cast<uintptr_t>(GraphicsContext::Instance())))
+        silent_scope::dc_scope::gpu_scope().context_lost();
+#endif
 	// the kept frames point into the texture cache, the screen program into this context
 	vrFrameValid = false;
 	vrShowFramebuffer = false;
