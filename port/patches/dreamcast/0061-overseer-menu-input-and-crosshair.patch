+    glm::vec2 uv;
+    pointing[ssOwner]=ray.valid&&settingsPanelHit(model,panel,ray.origin,ray.dir,&pointAt[ssOwner],&uv);
+    const auto hit=pointing[ssOwner]?settingsAt(panel,uv):SettingsHit{};
+    if(!fresh&&!gunsTurned&&!transfer&&hit.kind!=SettingsHit::Kind::None&&!sameHit(hit,ssHovered))ssFocus=hit;
+    ssHovered=hit;
+    const bool suppress=fresh||gunsTurned||transfer;
+    fresh=gunsTurned=false;
+    if(transfer||suppress)return;
+    const auto controls=input.perHand?input.hand[ssOwner]:
+        Input::Hand{input.select,input.back,input.up,input.down,input.left,input.right,input.repeat};
+    if(controls.back){ssBack();return;}
+    if(!input.perHand&&input.back){ssBack();return;}
+    using Kind=SettingsHit::Kind;
+    if(controls.up||controls.down){
+        std::vector<SettingsHit> navigation;
+        if(ssConfirmation<0){
+            for(int tab=0;tab<4;++tab)navigation.push_back({Kind::Tab,tab});
+            if(panel.back)navigation.push_back({Kind::Back});
+        }
+        for(int row=0;row<int(panel.rows.size());++row)navigation.push_back({Kind::Row,row});
+        navigation.push_back({Kind::Close});
+        int at=-1;
+        for(int n=0;n<int(navigation.size());++n)if(sameHit(ssFocus,navigation[n]))at=n;
+        at=(at+(controls.up?-1:1)+int(navigation.size()))%int(navigation.size());
+        ssFocus=navigation[at];
+    }
+    if(ray.click&&hit.kind!=Kind::None){ssActivate(hit);return;}
+    if(controls.left||controls.right){
+        const int direction=controls.left?-1:1;
+        if(ssFocus.kind==Kind::Tab&&!controls.repeat){
+            ssPage=SsPage((ssFocus.index+direction+4)%4);
