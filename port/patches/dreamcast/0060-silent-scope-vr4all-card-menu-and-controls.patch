+SettingsHit ssFocus;
+
+std::vector<int> ssRows()
+{
+    if(ssConfirmation>=0)return {Cancel,Confirm};
+    switch(ssPage){
+    case SsPage::Gun: return {Gun,GunAngle,Laser,Reticle,Haptics,AdvancedGun};
+    case SsPage::GunAdvanced: return {AimSmoothing,ScopeStability,ScopeZoom,ReticleMinSize,ReticleMaxSize,ReticleShrinkDistance};
+    case SsPage::World: return {WiderView,AdvancedWorld};
+    case SsPage::WorldAdvanced: return {WorldSize,HudSize,PanelDistance};
+    case SsPage::System: return {Hand,HowToPlay,FpsCounter,ResetDefaults,Quit};
+    case SsPage::Game: return {};
+    }
+    return {};
+}
+
+SettingsPanel ssPanel()
+{
+    SettingsPanel p;
+    p.game="Silent Scope";
+    p.activeTab=ssPage==SsPage::GunAdvanced?0:ssPage==SsPage::WorldAdvanced?1:int(ssPage);
+    p.selectedTab=ssFocus.kind==SettingsHit::Kind::Tab?ssFocus.index:-1;
+    p.back=ssPage==SsPage::GunAdvanced||ssPage==SsPage::WorldAdvanced;
+    p.backSelected=ssFocus.kind==SettingsHit::Kind::Back;
+    p.closeSelected=ssFocus.kind==SettingsHit::Kind::Close;
+    p.dialog=ssConfirmation>=0;
+    const char* titles[]{"Gun","World","System","In-game","Advanced gun settings","Advanced world settings"};
+    p.title=p.dialog?(ssConfirmation==Quit?"Quit to the launcher?":"Reset VR settings?"):titles[int(ssPage)];
+    p.subtitle=p.dialog?(ssConfirmation==Quit?"Leave the current game.":"Restore the default VR preferences."):
+        ssPage==SsPage::Game?"Use the original Silent Scope options for game settings.":"Silent Scope / VR settings";
+    for(const int row:ssRows()){
+        SettingsRow r;
+        r.label=row==Confirm?(ssConfirmation==Quit?"Quit":"Reset VR settings"):Labels[row];
+        r.value=value(row);
+        r.selected=ssFocus.kind==SettingsHit::Kind::Row&&ssFocus.index==int(p.rows.size());
+        r.stepper=stepper(row);r.dim=ssDisabled(row);
+        r.action=row==AdvancedGun||row==AdvancedWorld||row==ResetDefaults||row==Quit||row==Cancel||row==Confirm;
+        if(row==Gun)r.choices={"Arcade","Simulation"};
+        if(row==Hand)r.choices={"Left","Right"};
+        if(row==Laser||row==HowToPlay||row==FpsCounter)r.choices={"Off","On"};
+        if(row==Reticle)r.choices={"Custom","None"};
+        if(row==Haptics)r.choices={"Off","Light","Medium","Strong"};
+        if(!r.choices.empty()){
+            const auto current=std::find(r.choices.begin(),r.choices.end(),r.value);
+            r.choice=current==r.choices.end()?-1:int(current-r.choices.begin());
+            r.stepper=false;
+        }
+        p.rows.push_back(std::move(r));
+    }
+    p.footer="Aim and pull trigger | B / Y to go back";
+    const auto saveError=silent_scope::dc_persistence::last_error();
+    if(!saveError.empty())p.footer="Settings not saved: "+saveError;
+    return p;
+}
+
+void ssBack()
+{
+    ssFocus={};
+    if(ssConfirmation>=0)ssConfirmation=-1;
+    else if(ssPage==SsPage::GunAdvanced)ssPage=SsPage::Gun;
+    else if(ssPage==SsPage::WorldAdvanced)ssPage=SsPage::World;
+    else close();
+}
+
+void ssUpdate(const Input& input)
+{
+    if(input.toggle){close();return;}
+    if(input.back){ssBack();return;}
+    pointing[0]=pointing[1]=false;
+    const int other=1-ssOwner;
+    if(!fresh&&input.ray[other].valid&&input.ray[other].click&&!input.ray[ssOwner].click){
+        ssOwner=other;
+        ssFocus={};
+        return;
+    }
+    const auto panel=ssPanel();
+    const auto& ray=input.ray[ssOwner];
+    glm::vec2 uv;
+    pointing[ssOwner]=ray.valid&&settingsPanelHit(model,panel,ray.origin,ray.dir,&pointAt[ssOwner],&uv);
+    ssFocus=pointing[ssOwner]?settingsAt(panel,uv):SettingsHit{};
+    const bool wasFresh=fresh;
+    fresh=false;
+    if(wasFresh||!ray.click)return;
+    using Kind=SettingsHit::Kind;
+    switch(ssFocus.kind){
+    case Kind::Close: close();return;
+    case Kind::Back: ssBack();return;
+    case Kind::Tab: ssPage=SsPage(ssFocus.index);ssFocus={};return;
+    case Kind::None: return;
+    case Kind::Row: break;
+    }
+    const auto rows=ssRows();
+    const auto& row=panel.rows[ssFocus.index];
+    if(row.dim)return;
+    const int action=rows[ssFocus.index];
+    if(action==AdvancedGun||action==AdvancedWorld){
+        ssPage=action==AdvancedGun?SsPage::GunAdvanced:SsPage::WorldAdvanced;
+        ssFocus={};
+    }else if(action==ResetDefaults||action==Quit){
+        ssConfirmation=action;ssFocus={};
+    }else if(action==Cancel)ssBack();
+    else if(action==Confirm){
+        const int confirmed=ssConfirmation;
+        ssConfirmation=-1;ssFocus={};
+        if(confirmed==Quit){quitting=true;quitToStart();}
+        else choose(confirmed,ssOwner);
+    }else if(ssFocus.choice>=0&&row.choice>=0){
+        const int delta=ssFocus.choice-row.choice;
+        for(int n=0;n<std::abs(delta);++n)change(action,delta<0?-1:1,ssOwner);
+    }else if(ssFocus.direction)change(action,ssFocus.direction,ssOwner);
+    else if(!row.choices.empty()&&row.choice==int(row.choices.size())-1){
+        for(int n=0;n<row.choice;++n)change(action,-1,ssOwner);
+    }else choose(action,ssOwner);
+}
