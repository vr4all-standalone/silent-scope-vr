+// The rifle renderer uses raw GL calls; restore every changed state so Flycast's
+// cached world/UI state still describes the actual driver state afterwards.
+struct SsGlState {
+    GLint program,vao,buffer,active,texture,sampler,depthFunc;
+    GLboolean depth,blend,cull,scissor,stencil,mask,color[4];GLfloat clearDepth;
+    SsGlState(){
+        glGetIntegerv(GL_CURRENT_PROGRAM,&program);glGetIntegerv(GL_VERTEX_ARRAY_BINDING,&vao);glGetIntegerv(GL_ARRAY_BUFFER_BINDING,&buffer);
+        glGetIntegerv(GL_ACTIVE_TEXTURE,&active);glActiveTexture(GL_TEXTURE0);glGetIntegerv(GL_TEXTURE_BINDING_2D,&texture);glGetIntegerv(GL_SAMPLER_BINDING,&sampler);
+        glGetIntegerv(GL_DEPTH_FUNC,&depthFunc);glGetBooleanv(GL_DEPTH_WRITEMASK,&mask);glGetBooleanv(GL_COLOR_WRITEMASK,color);glGetFloatv(GL_DEPTH_CLEAR_VALUE,&clearDepth);
+        depth=glIsEnabled(GL_DEPTH_TEST);blend=glIsEnabled(GL_BLEND);cull=glIsEnabled(GL_CULL_FACE);scissor=glIsEnabled(GL_SCISSOR_TEST);stencil=glIsEnabled(GL_STENCIL_TEST);
+    }
+    ~SsGlState(){
+        glUseProgram(program);glBindVertexArray(vao);glBindBuffer(GL_ARRAY_BUFFER,buffer);glActiveTexture(GL_TEXTURE0);glBindTexture(GL_TEXTURE_2D,texture);glBindSampler(0,sampler);glActiveTexture(active);
+        glDepthFunc(depthFunc);glDepthMask(mask);glColorMask(color[0],color[1],color[2],color[3]);glClearDepthf(clearDepth);
+        auto restore=[](GLenum cap,bool on){if(on)glEnable(cap);else glDisable(cap);};
+        restore(GL_DEPTH_TEST,depth);restore(GL_BLEND,blend);restore(GL_CULL_FACE,cull);restore(GL_SCISSOR_TEST,scissor);restore(GL_STENCIL_TEST,stencil);
+    }
+};
+void drawSilentScope(const glm::mat4& vp,const glm::vec3& eyePos,const ss::dc_scope::TextureView& scope){
+    SsGlState state;
+    glDisable(GL_SCISSOR_TEST);glDisable(GL_STENCIL_TEST);glDepthMask(GL_TRUE);glDepthFunc(GL_LEQUAL);glClearDepthf(1);glColorMask(GL_TRUE,GL_TRUE,GL_TRUE,GL_TRUE);glBindSampler(0,0);
+    glClear(GL_DEPTH_BUFFER_BIT);
+    ssRifle->draw_rifle_texture(vp,ssRifleModel,eyePos,scope.texture,1.f,!scope.content_top_at_v0);
+}
+void drawSilentScopeInfo(const glm::mat4& vp){
+    if(ss::dc_settings::fps_counter()){
+        char label[128];std::snprintf(label,sizeof(label),"XR %.1f Hz   Native main %.1f Hz",ssRates.xr_hz(),ssRates.native_hz());
+        int w=0,h=0;auto tex=textTexture(label,32,theme::Accent,w,h);
+        if(tex&&h>0)drawTexture(vp,glm::translate(headPose(),glm::vec3(0,.45f,-1.5f)),tex,.022f*w/h,.022f);
+    }
+    if(menuHowToPlay){
+        const char* lines[]={"Trigger: Fire / select native screen", "A / X: Start / Pause", "B / Y: hold 0.8s for Menu", "Offhand grip near fore-end: Support", "Left Menu: Settings"};
+        for(int n=0;n<5;++n){int w=0,h=0;auto tex=textTexture(lines[n],32,theme::Accent,w,h);
+            if(tex&&h>0)drawTexture(vp,glm::translate(headPose(),glm::vec3(0,.2f-.075f*n,-1.4f)),tex,.025f*w/h,.025f);}
+    }
 }
 
