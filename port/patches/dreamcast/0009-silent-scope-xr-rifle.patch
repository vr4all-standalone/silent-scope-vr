+// Silent Scope console adapter. All world consumers share this one calibrated
+// and optionally stabilized physical model. No generic gun, P2 or slide path.
+void updateSilentScope(XrTime time)
+{
+    ssRifleValid=false;
+    frameWorldZoom=1.f;
+    if(menuHowToPlay&&!menuOpen)setHowToPlay(false,"menu closed");
+    for(auto& g:guns) g.visible=false;
+    pointerShown[Left]=pointerShown[Right]=false;
+    ss::dc_xr::Target target;target.hand=ss::dc_settings::primary_hand();
+    target.focused=focused;target.menu=menuOpen;target.host_seconds=ss::dc_scope::monotonic_seconds();
+    auto release=[&]{ssSupport.reset();ssFireWas=ssSubmittedFireWas=false;ss::dc_xr::input_bridge().submit(target);};
+    if(!focused){ssSecondaryArmed=false;ssSecondarySince=0;release();return;}
+    const XrActiveActionSet active{actionSet,XR_NULL_PATH};
+    XrActionsSyncInfo sync{XR_TYPE_ACTIONS_SYNC_INFO};sync.countActiveActionSets=1;sync.activeActionSets=&active;
+    if(!XR_SUCCEEDED(XR(xrSyncActions)(session,&sync))){release();return;}
+    const bool menu=boolAction(menuAction),secondary=boolAction(skipAction);
+    bool menuEdge=menu&&!ssMenuWas;ssMenuWas=menu;
+    // B/Y hold is a fallback even when the runtime also exposes Left Menu.
+    if(!secondary){ssSecondaryArmed=true;ssSecondaryConsumed=false;ssSecondarySince=0;}
+    else if(ssSecondaryArmed&&!ssSecondaryConsumed){
+        if(!ssSecondarySince)ssSecondarySince=time;
+        else if(time-ssSecondarySince>=800000000LL){menuEdge=true;ssSecondaryConsumed=true;}
+    }
+    const bool secondaryEdge=secondary&&!ssSecondaryWas;ssSecondaryWas=secondary;
+    if(menuOpen){
+        release();updateMenu(time,menuEdge,secondary,secondaryEdge);return;
+    }
+    if(menuEdge){
+        ss::dc_xr::input_bridge().invalidate();ssSupport.reset();ssFireWas=false;
+        menu::open(headPose());target.menu=true;ss::dc_xr::input_bridge().submit(target);return;
+    }
+    const bool center=boolAction(recenterAction);
+    if(center&&!recenterWas)recenter();recenterWas=center;
+    const bool laser=boolAction(laserAction);
+    if(laser&&!laserWas){config::VrLaser.set(!config::VrLaser);config::saveBool("config","vr.Laser",config::VrLaser);}
+    laserWas=laser;
+    XrSpaceLocation aim[2];bool tracked[2];locateHands(time,aim,tracked);
+    constexpr auto required=XR_SPACE_LOCATION_POSITION_VALID_BIT|XR_SPACE_LOCATION_ORIENTATION_VALID_BIT|
+        XR_SPACE_LOCATION_POSITION_TRACKED_BIT|XR_SPACE_LOCATION_ORIENTATION_TRACKED_BIT;
+    std::array<ss::RifleSupportHand,2> hands;
+    for(int h:{Left,Right}){
+        tracked[h]=tracked[h]&&(aim[h].locationFlags&required)==required;
+        const auto room=glm::translate(glm::mat4(1),relativePosition(aim[h].pose.position))*glm::mat4_cast(relativeRotation(aim[h].pose.orientation));
+        // Primary: accepted aim orientation with the displayed angle baseline,
+        // translated to the runtime's handle. Offhand: runtime handle position.
+        glm::vec3 palm=HandPalm;XrSpaceLocation grip{XR_TYPE_SPACE_LOCATION};
+        if(XR_SUCCEEDED(XR(xrLocateSpace)(gripSpaces[h],aimSpaces[h],time,&grip)) &&
+           (grip.locationFlags&required)==required && glm::length(toVec(grip.pose.position))<.25f)palm=toVec(grip.pose.position);
+        auto model=glm::translate(room,palm);
+        if(h==target.hand)model=glm::rotate(model,glm::radians(float(gun_angle::displayed(config::VrGunAngle)-10)),glm::vec3(1,0,0));
+        hands[h]={model,tracked[h],floatAction(gripAction,h)>.7f};
+    }
+    target.tracked=ssHeadTracked&&originSet&&tracked[target.hand];
+    const auto supported=ssSupport.update(hands,{target.focused&&ssHeadTracked,false,target.hand});
+    if(supported.valid)ssRifleModel=supported.model;
+    const auto* ctx=gles_vr_frame();
+    if(ctx&&ctx->dcCamera.generation!=ssNativeGeneration){
+        ssNativeGeneration=ctx->dcCamera.generation;ss::dc_xr::input_bridge().invalidate();ssSupport.reset();ssSubmittedFireWas=false;
+    }
+    const bool native3d=ctx && ctx->dcCamera.supported && ctx->dcCamera.code_guard_valid &&
+        !ctx->dcCamera.is_rtt && ctx->dcCamera.submit_sequence && config::VrReproject && !gles_vr_showing_framebuffer();
+    ssRifleValid=config::VrXrGun&&native3d&&target.tracked&&supported.valid&&!menuHowToPlay;
+    const bool pull=floatAction(triggerAction,target.hand)>(ssFireWas?.35f:.6f);
+    target.start=boolAction(startAction,Left)||boolAction(startAction,Right);
+    if(target.tracked&&supported.valid&&(ctx||gles_vr_showing_framebuffer())){
+        const auto muzzle=glm::vec3(ssRifleModel*glm::vec4(0,.005f,-.94f,1));
+        const auto forward=glm::normalize(glm::vec3(ssRifleModel*glm::vec4(0,0,-1,0)));
+        const float scale=worldScale();
+        if(std::isfinite(scale)&&scale>0){
+            const glm::vec3 o=glm::vec3(muzzle.x,-muzzle.y,muzzle.z)/scale;
+            const glm::vec3 d=glm::normalize(glm::vec3(forward.x,-forward.y,forward.z));
+            target.native_direction={d.x,d.y,d.z};target.direction_valid=native3d;
+            glm::vec2 screen;float dist=-1;glm::vec3 native(0);
+            bool hit=false;
+            if(!native3d)hit=aimAtFlatScreen(o,d,screen,dist);
+            else hit=aimAtScene(*ctx,o,d,screen,dist,&native);
+            const bool scene=aimHow&&strcmp(aimHow,"3D")==0&&dist>0&&dist<10000;
+            // Flat boot warning/title and actual native overlay panels accept a
+            // separate fresh click. Their plane hit is never a gameplay shot.
+            target.native_ui=!native3d;
+            if(target.native_ui){native=o+d*dist;target.point_valid=hit&&dist>0;target.ui_select=pull;}
+            // Native gameplay HUD never changes the native input domain. If
+            // the generic picker reports a HUD hit, keep only the barrel ray:
+            // no false marker on the HUD, and no loss of legitimate sky shots.
+            else {target.point_valid=scene;target.fire=pull&&native3d;}
+            target.native_point={native.x,native.y,native.z};
+            if(target.point_valid){
+                auto& line=pointers[target.hand];line=GunView();line.restMuzzle=muzzle;line.restForward=forward;
+                line.pose=glm::translate(ssRifleModel,glm::vec3(0,.005f,-.94f)-gunMuzzle(line.kind));
+                line.aimPoint=muzzle+forward*(dist*scale);line.aimLine=config::VrLaser;
+                line.aimDot=true;line.now=target.host_seconds;line.menuPointer=target.native_ui;
+                line.reticleHead=headPose();line.reticlePanelDistance=float(config::VrHudDepth)*scale;
+                pointerShown[target.hand]=true;
+            }
+        }
+    }
+    ss::dc_xr::Target emitted;const bool delivered=ss::dc_xr::input_bridge().submit(target,&emitted);
+    // A controller pulse acknowledges a fresh input gesture only. Native hit
+    // confirmation is intentionally not inferred from this submission.
+    if(delivered&&emitted.fire&&!ssSubmittedFireWas)haptic(target.hand,.02f,.5f);
+    ssSubmittedFireWas=emitted.fire;ssFireWas=pull;
+}
