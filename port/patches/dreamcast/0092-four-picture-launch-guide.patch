+bool paintPictureGuide(const Panel& panel)
+{
+    if (!panel.pictureGrid || panel.lines.size() != 9)
+        return false;
+    size_t bytes = 0;
+    auto image = resource::load("picture/silent-scope-how-to.png", bytes);
+    int w = 0, h = 0, channels = 0;
+    stbi_set_flip_vertically_on_load_thread(0);
+    u8* decoded = image ? stbi_load_from_memory(image.get(), (int)bytes, &w, &h, &channels, 4) : nullptr;
+    if (decoded == nullptr || w != 1536 || h != 1024)
+    {
+        stbi_image_free(decoded);
+        WARN_LOG(RENDERER, "XR: Silent Scope instruction pictures unavailable");
+        return false;
+    }
+    canvasWidth = w;
+    canvasHeight = h;
+    pixels.assign(decoded, decoded + size_t(w) * h * 4);
+    stbi_image_free(decoded);
+    if (panel.mirrorPictures)
+    {
+        // Mirror each picture within its own card, preserving the four actions.
+        for (int y = 0; y < h; ++y)
+            for (int half = 0; half < 2; ++half)
+                for (int x = 0; x < w / 4; ++x)
+                    for (int c = 0; c < 4; ++c)
+                        std::swap(pixels[(size_t(y) * w + half * (w / 2) + x) * 4 + c],
+                            pixels[(size_t(y) * w + (half + 1) * (w / 2) - 1 - x) * 4 + c]);
+    }
+    fill(36, 88, w - 36, 90, theme::Line);
+    fill(w / 2 - 1, 104, w / 2 + 1, 932, theme::Line);
+    fill(36, 511, w - 36, 513, theme::Line);
+    fill(36, 950, w - 36, 952, theme::Line);
+    text(panel.lines[0].text, 42.f, w * .5f, 63, panel.lines[0].colour);
+    for (int tile = 0; tile < 4; ++tile)
+    {
+        const float x = w * (tile % 2 ? .75f : .25f);
+        const int top = tile < 2 ? 132 : 568;
+        const int bottom = tile < 2 ? 485 : 921;
+        const auto& title = panel.lines[1 + tile * 2];
+        const auto& caption = panel.lines[2 + tile * 2];
+        text(title.text, 35.f, x, top, title.colour);
+        text(caption.text, 27.f, x, bottom, caption.colour);
+    }
+    text(panel.footer, 25.f, w * .5f, 992, panel.footerColour);
+    return true;
+}
