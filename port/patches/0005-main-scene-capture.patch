+// Cache exactly the bytes consumed by capture_argb, including wrapped RAM and
+// mutable palette/NCC contents. Static lookup tables are fixed by format.
+void rasterizer_texture::capture_source(u32 format, silent_scope::scene::TextureSource &source) const
+{
+ source.width=capture_width();source.height=capture_height();source.lod=capture_lod();source.format=format;
+ const size_t bpp=format<8?1:2,size=size_t(source.width)*source.height*bpp;
+ source.bytes.resize(size);const u32 base=m_lodoffset[source.lod];
+ if(bpp==1||((base&1)==0&&(m_mask&1)!=0)){
+  size_t done=0;u32 address=base;
+  while(done<size){size_t count=std::min(size-done,size_t(m_mask)+1-address);
+   std::memcpy(source.bytes.data()+done,m_ram+address,count);done+=count;address=0;}
+ }else{
+  for(size_t i=0;i<size;i+=2)std::memcpy(source.bytes.data()+i,m_ram+((base+i)&m_mask),2);
+ }
+ const bool mutable_lookup=format==1||format==5||format==6||format==7||format==9||format==14||format==15;
+ source.palette.resize(mutable_lookup?256:0);
+ for(size_t i=0;i<source.palette.size();i++)source.palette[i]=u32(m_lookup[i]);
+}
+
+// A scene snapshot must not retain references to live TMU RAM or palette tables.
+std::vector<u32> rasterizer_texture::capture_argb(u32 format)
+{
+	std::vector<u32> pixels(capture_width() * capture_height());
+	for (u32 y = 0; y < capture_height(); ++y)
+		for (u32 x = 0; x < capture_width(); ++x)
+			pixels[y * capture_width() + x] = lookup_single_texel(format, m_lodoffset[capture_lod()], x, y * capture_width());
+	return pixels;
+}
+
